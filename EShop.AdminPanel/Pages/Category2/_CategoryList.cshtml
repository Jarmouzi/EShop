@using EShop.ViewModel;
@model PaginatedViewModel<CategoryViewModel>

<table class="table table-bordered" id="categories">
    <thead>
        <tr>
            <th>عملیات</th>
            <th>عنوان</th>
            <th>سطح</th>
            <th>تایید</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Any())
        {
            int i = 1;
            @foreach (var c in Model.Data)
            {                
                <tr>
                    <td class="d-inline">
                        <span style="padding-left: 3px;">@(i++)</span>
                        <form method="post" asp-page="Index" asp-route-id="@c.Id" asp-page-handler="Delete" onsubmit="return jQueryDelete(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="حذف" class="d-link"> <i class="fa fa-remove"></i></button>
                        </form> 
                        <a onclick="jQueryGet('?handler=FormPartial&id=@c.Id','categoryForm', 'ویرایش')" data-toggle="tooltip" data-placement="top" title="ویرایش"> <i class="fa fa-edit"></i> </a>

                    </td>
                    <td>@c.Title</td>
                    <td>@c.Level</td>
                    <td>
                        @if (c.Confirmed)
                        {
                            <input type="checkbox" checked="checked" disabled="disabled" />
                        }
                        else
                        {
                            <input type="checkbox" disabled="disabled" />
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                رکوردی یافت نشد
            </tr>

        }
    </tbody>
</table>
<partial name="_paginationpartial" model="@Model.Pagination" />
<script>
    $(document).ready(function () {
        $("#categoryTable").DataTable();
    });
</script>
@page
@model EShop.AdminPanel.Pages.Category.IndexModel
@{
    ViewData["Title"] = "گروهبندی محصولات";
}
<section class="content-header">
    <h1>
        @ViewData["Title"]
    </h1>
    <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> داشبورد</a></li>
        <li><a href="#"><i class="fa fa-archive"></i> محصولات</a></li>
        <li class="active">
            @ViewData["Title"]
        </li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                @*                 <div class="box-header with-border">
                <h3 class="box-title">
                @ViewData["Title"]
                </h3>
                </div> *@
                <form role="form" id="registerForm" method="post" class="form-horizontal">
                    <div class="box-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-group col-md-6">
                            <label class="control-label">گروه بندی سطح 1</label>
                            <select id="CategoryIdd" asp-items="Model.PrimaryCategories" class="form-control">
                                <option value="">انتخاب نمایید</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="_Category.ParentId" class="control-label">گروه بندی سطح 2</label>
                            <select asp-for="_Category.ParentId" asp-items="Model.SecondaryCategories" class="form-control">
                                <option value="">انتخاب نمایید</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="control-label">عنوان گروهبندی بندی</label>
                            <input type="text" class="form-control" asp-for="_Category.Title" placeholder="عنوان دسته بندی">
                        </div>
                    </div>
                    <div class="box-footer clearfix">
                        <div class="pull-left">
                            <button type="submit" class="btn btn-success">ایجاد</button>
                            <a href="/warning/Index" class="btn btn-info ">بازگشت</a>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <h3 id="list-title" class="box-title">
                        لیست گروهبندی محصولات در سطح 1
                    </h3>
                </div>
                <div class="table-responsive">
                    <table class="table no-margin">
                        <thead>
                            <tr>
                                <th>عملیات</th>
                                <th>عنوان</th>
                                <th>تایید</th>
                            </tr>
                        </thead>
                        <tbody id="categories">
                            @foreach (var c in Model.Categories)
                            {
                                <tr>
                                    <td>
                                        <a href="" data-toggle="tooltip" data-placement="top" title="حذف" data-id="@c.Id" class="deleteItem"> <i class="fa fa-remove"></i>  </a> |
                                        <a href="" data-toggle="tooltip" data-placement="top" title="ویرایش" data-id="@c.Id" class="updateItem"> <i class="fa fa-edit"></i>  </a> |
                                        <a asp-page="./Filter" asp-route-id="@c.Id" data-toggle="tooltip" data-placement="top" title="تعریف فیلتر های جستجو"><i class="fa fa-search"></i>  </a>

                                    </td>
                                    <td>@c.Title</td>
                                    <td>
                                        @if (c.Confirmed)
                                        {
                                            <input type="checkbox" checked="checked" disabled="disabled" />
                                        }
                                        else
                                        {
                                            <input type="checkbox" disabled="disabled" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
</section>


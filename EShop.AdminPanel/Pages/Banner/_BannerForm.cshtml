 @model EShop.ViewModel.BannerViewModel

<form id="create-form" enctype="multipart/form-data" method="post" asp-page="Index" asp-route-id="@Model.Id" asp-page-handler="CreateOrEdit" onsubmit="return jQueryModalPost(this);" class="form-horizontal">
    @* <input type="hidden" asp-for="CreateDate" /> *@
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-group col-md-6">
        <label class="control-label">عنوان بنر</label>
        <input type="text" autocomplete="off" asp-for="Title" name="Title" class="form-control">
        <span asp-validation-for="Title" class="text-danger"></span>

    </div>
    <div class="form-group col-md-6">
        <label class="control-label" asp-for="UploadedFile"></label>
        <input asp-for="UploadedFile" type="file" class="form-control">
        <span asp-validation-for="UploadedFile"></span>
    </div>
    <div class="form-group col-md-12">
        <label class="control-label">لینک بنر</label>
        <input type="text" autocomplete="off" asp-for="Path" name="Path" class="form-control">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        @Html.CheckBoxFor(m => m.Confirmed)
        <label class="control-label">تایید</label>
    </div>
    <div class="form-group col-md-12 pull-left">
        <div class="pull-left">
            <a onclick="clearForm()" class="btn btn-default">خالی کردن فرم</a>
            <button id="saveBtn" type="submit" class="btn btn-success">ایجاد</button>
            <a onclick="Search(0);" class="btn btn-info">جستجو</a>
        </div>
    </div>

</form>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);

</script>
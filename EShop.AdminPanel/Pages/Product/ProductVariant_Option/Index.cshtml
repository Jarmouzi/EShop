@page
@model EShop.AdminPanel.Pages.BasicInfo.ProductVariant_Option.IndexModel
@{
    ViewData["Title"] = "ProductVariant_Option";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="productvariant_optionForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#productvariant_optionForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $("#create-form").attr("action", "/ProductVariant_Option?id=&handler=CreateOrEdit"); 
            $(".validation-summary-errors").val("");
            $("field-validation-error").val("");  
			$('#OptionId).val(');  
			$('#OptionValueId).val(');  
			$('#ProductVariantId).val('); 
            $("#saveBtn").html("?????");
        }

        Search = (take, skip) => {  
			var OptionId = $("input#OptionId").val(); 
			var OptionValueId = $("input#OptionValueId").val(); 
			var ProductVariantId = $("input#ProductVariantId").val();
            $("#viewAll").load(`?handler=ViewAllPartial&&amp;OptionId=${OptionId}&amp;OptionValueId=${OptionValueId}&amp;ProductVariantId=${ProductVariantId}&take=${take}&skip=${skip}`);
        }
    </script>
}

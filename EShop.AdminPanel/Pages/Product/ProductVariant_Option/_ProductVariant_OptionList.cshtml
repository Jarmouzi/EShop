@using EShop.ViewModel;
@model PaginatedViewModel<ProductVariant_OptionViewModel>

<table class="table table-bordered" id="productvariant_options">
    <thead>
        <tr>
            <th>عملیات</th>
            <th>عنوان</th>
            <th>کشور</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Any())
        {
            @foreach (var m in Model.Data)
            {
                <tr>
                    <td class="d-inline">
                        <form method="post" asp-page="Index" asp-route-id="@m.Id" asp-page-handler="Delete" onsubmit="return jQueryDelete(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="حذف" class="d-link"> <i class="fa fa-remove"></i></button>
                        </form> |
                        <a onclick="jQueryGet('?handler=FormPartial&id=@m.Id',productvariant_optionForm', 'ویرایش')" data-toggle="tooltip" data-placement="top" title="ویرایش"> <i class="fa fa-edit"></i> </a>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                رکوردی یافت نشد
            </tr>

        }
    </tbody>
</table>
<partial name="_paginationpartial" model="@Model.Pagination" />
<script>
    $(document).ready(function () {
        $("#productvariant_optionTable").DataTable();
    });
</script>

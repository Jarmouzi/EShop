@page
@model EShop.AdminPanel.Pages.Product.Product_Image.IndexModel
@{
    ViewData["Title"] = "Product_Image";
    var pId = "pId=" + (Model.ProductId == null ? "" : Model.ProductId.ToString());
    var oId = "oId="  + (Model.Product_OptionId == null ? "" : Model.Product_OptionId.ToString());
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="product_imageForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#product_imageForm').load(`?handler=FormPartial&${'@pId'}&${'@oId'}&id=`);
            $('#viewAll').load(`?handler=ViewAllPartial&${'@pId'}&${'@oId'}`);
        });

        clearForm = () => {
            $("#create-form").attr("action", "/Product_Image?id=&handler=CreateOrEdit"); 
            $(".validation-summary-errors").val("");
            $("field-validation-error").val("");  
			$('#Confirmed).val(');  
			$('#Featured).val(');  
			$('#ImageId).val(');  
			$('#ProductId).val(');  
			$('#ProductVariantId).val('); 
            $("#saveBtn").html("ایجاد");
        }

        Search = (take, skip) => {  
			var Confirmed = $("input#Confirmed").val(); 
			var Featured = $("input#Featured").val(); 
			var ImageId = $("input#ImageId").val(); 
			var ProductId = $("input#ProductId").val(); 
			var ProductVariantId = $("input#ProductVariantId").val();
            $("#viewAll").load(`?handler=ViewAllPartial&Confirmed=${Confirmed}&Featured=${Featured}&ImageId=${ImageId}&ProductId=${ProductId}&ProductVariantId=${ProductVariantId}&take=${take}&skip=${skip}`);
        }
    </script>
}

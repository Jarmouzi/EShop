@using EShop.ViewModel;
@model PaginatedViewModel<Product_ImageViewModel>


@if (Model.Data.Any())
{
    @foreach (var m in Model.Data)
    {
        <div class="box box-info">
            <div class="box-header with-border">
                @if (m.Confirmed == true)
                {
                    <input type="checkbox" class="pull-right" checked="checked" disabled="disabled" />
                }
                else
                {
                    <input type="checkbox" class="pull-right" disabled="disabled" />
                }
                @if (m.Featured == true)
                {
                    <h5>تصویر شاخص</h5>    
                }

                <form class="pull-left" method="post" asp-page="Index" asp-route-id="@m.Id" asp-page-handler="Delete" onsubmit="return jQueryDelete(this)">
                    <button type="submit" data-toggle="tooltip" data-placement="top" title="حذف" class="d-link"> <i class="fa fa-remove"></i></button>
                </form>
                <a class="pull-left" onclick="jQueryGet('?handler=FormPartial&id=@m.Id',product_imageForm', 'ویرایش')" data-toggle="tooltip" data-placement="top" title="ویرایش"> <i class="fa fa-edit"></i> </a>

            </div>
            <div class="box-body">
                <img alt="@m.ImageAlt" src="@m.ImageUrl" />
            </div>
        </div>
    }
}
else
{
    <div class="box box-info">
        رکوردی یافت نشد
    </div>

}

<partial name="_paginationpartial" model="@Model.Pagination" />
<script>
    $(document).ready(function () {
        $("#product_imageTable").DataTable();
    });
</script>

@model EShop.ViewModel.Product_ImageViewModel
<form id="create-form" method="post" asp-page="Index" asp-route-id="@Model.Id" asp-route-pid="@Model.ProductId" asp-route-oid="@Model.Product_OptionId" asp-page-handler="CreateOrEdit" onsubmit="return jQueryModalPost(this);" class="form-horizontal">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="box-header with-border">
        <h4 class="box-title">@Model.ProductTitle</h4>
        <h6 class="box-pane">@Model.OptionTitle </h6>
        <h6 class="box-pane">@Model.ValueTitle </h6>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label">عنوان تصویر</label>
        <input type="text" autocomplete="off" asp-for="ImageAlt" name="Title" class="form-control">
        <span asp-validation-for="ImageAlt" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label" asp-for="UploadedFile"></label>
        <input asp-for="UploadedFile" type="file" class="form-control">
        <span asp-validation-for="UploadedFile"></span>
    </div>
    <div class="form-group col-md-3 mt-5">
        <label class="control-label">تصویر شاخص</label>
        <input type="checkbox" autocomplete="off" asp-for="Featured" name="Featured" class="form-control">
        <span asp-validation-for="Featured" class="text-danger"></span>
    </div>
    <div class="form-group col-md-3 mt-5">
        <label class="control-label">تایید</label>
        <input type="checkbox" autocomplete="off" asp-for="Confirmed" name="Confirm" class="form-control">
        <span asp-validation-for="Confirmed" class="text-danger"></span>
    </div>
    <div class="form-group col-md-12 pull-left">        
        <div class="pull-left">
            <a onclick="clearForm()" class="btn btn-default">خالی کردن فرم</a>
            <button id="saveBtn" type="submit" class="btn btn-success">ایجاد</button>
            <a onclick="Search(0);" class="btn btn-info">جستجو</a>
        </div>
    </div>

</form>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);

</script>

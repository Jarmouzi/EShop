@page
@model EShop.AdminPanel.Pages.Product.IndexModel
@{
    ViewData["Title"] = "تعریف محصول";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="productForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#productForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&categoryId=&brandId=&titl=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/Product?id=&handler=CreateOrEdit');
            $("select#CategoryId").val('');
            $("select#BrandId").val('');
            $('#Title').val('');
            $('#Description').val('');
            $('#AvailableForSale').val('');
            $('#Confirmed').val('');
            $(".validation-summary-errors").val("");
            $("field-validation-error").val("");
            $('#saveBtn').html('ایجاد');
        }

        Search = (skip) => {
            var categoryId = $("select#CategoryId").val();
            var brandId = $("select#BrandId").val();
            var title = $("input#Title").val();
            var take = $("select#Take").val();
            $('#viewAll').load(`?handler=ViewAllPartial&categoryId=${categoryId}&brandId=${brandId}&titl=${title}&take=${take}&skip=${skip}`);
        }
    </script>
}

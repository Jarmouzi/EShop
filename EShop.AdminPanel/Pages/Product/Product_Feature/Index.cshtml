@page
@model EShop.AdminPanel.Pages.Product.Product_Feature.IndexModel
@{
    ViewData["Title"] = "ویژگی های محصول";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="product_featureForm" class="row"></div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <script type="text/javascript" language=javascript>
        addFeatures = form => {
            try {
                debugger;
                var product_features = [];
                $(".feature").each(function (index, item) {
                    var pf = {};
                    pf.Id = parseInt($(item).find("#Id").val());
                    pf.ProductId = parseInt($(item).find("#ProductId").val());
                    pf.FeatureId = parseInt($(item).find("#FeatureId").val());
                    pf.IsMain = $(item).find("#IsMain").val();
                    pf.Value = $(item).find("#Value").val();
                    product_features.push(pf);
                });

                $.ajax({
                    type: "POST",
                    url: form.action,
                    //dataType: "json",
                    //contentType: 'application/json',
                    contentType: false,
                    processData: false,
                    // headers: {
                    //     RequestVerificationToken:
                    //         $('input:hidden[name="__RequestVerificationToken"]').val()
                    // },
                    data: new FormData(product_features),
                    success: function (data) {

                        alert(data);
                    }
                });
                return false;
            } catch (ex) {
                console.log(ex)
            }
        }
    </script>
}


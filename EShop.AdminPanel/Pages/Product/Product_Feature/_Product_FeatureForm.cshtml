@using System.Web
@model List<EShop.ViewModel.Product_FeatureViewModel>
<form id="create-form" method="post" asp-page="Index" asp-page-handler="CreateOrEdit" onsubmit="return addFeatures(this);" class="form-horizontal">

    <div class="col-12 box-group" id="accordion">
        @foreach (var p in Model.GroupBy(m => m.ParentFeatureId).Select(m => m.First()))
        {
            var list = Model.Where(m => m.ParentFeatureId == p.ParentFeatureId).ToList();
            <div class="panel box box-primary">
                <div class="box-header with-border">
                    <h4 class="box-title">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapse_@p.ParentFeatureId">
                            @p.ParentFeatureTitle
                        </a>
                    </h4>
                </div>
                <div id="collapse_@p.ParentFeatureId" class="panel-collapse collapse">
                    <div class="box-body">
                        @foreach (var c in list)
                        {
                            <partial name="_FeatureField" model="@c"></partial>
                        }
                    </div>
                </div>
            </div>

            @*             <div class="card card-primary card-outline">
        <a class="d-block w-100 collapsed" data-toggle="collapse" href="#collapseOne" aria-expanded="false">
        <div class="card-header">
        <h4 class="card-title w-100">
        @p.ParentFeatureTitle
        </h4>
        </div>
        </a>
        <div id="collapseOne" class="collapse" data-parent="#accordion" style="">
        <div class="card-body">
        @foreach (var c in list)
        {
        <partial name="_FeatureField" model="@c"></partial>
        }
        </div>
        </div>
        </div> *@
        }
    </div>

    <div class="form-group col-md-12 pull-left">
        <div class="pull-left">
            <button id="saveBtn" type="submit" class="btn btn-success">ثبت</button>
        </div>
    </div>

</form>
@* <script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);
</script> *@


<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);

    addFeatures = form => {
        try {
            debugger;
            var product_features = [];
            $(".feature").each(function (index, item) {
                var pf = {};
                pf.Id = parseInt($(item).find("#Id").val());
                pf.ProductId = parseInt($(item).find("#ProductId").val());
                pf.FeatureId = parseInt($(item).find("#FeatureId").val());
                pf.IsMain = $(item).find("#IsMain").val() === 'true';
                pf.Value = $(item).find("#Value").val();
                product_features.push(pf);
            });

            $.ajax({
                type: "POST",
                url: form.action,
                dataType: "json",
                contentType: 'application/json',
                // contentType: false,
                processData: false,
                // headers: {
                //     RequestVerificationToken:
                //         $('input:hidden[name="__RequestVerificationToken"]').val()
                // },
                data: JSON.stringify(product_features),
                success: function (data) {

                    alert(data);
                },
                error: function (err) {
                    console.log(err)
                }
            });
            return false;
        } catch (ex) {
            console.log(ex)
        }
    }
</script>

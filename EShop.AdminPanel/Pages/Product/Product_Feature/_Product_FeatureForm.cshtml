@using System.Web
@model List<EShop.ViewModel.Product_FeatureViewModel>
<form id="create-form" method="post" asp-page="Index" asp-page-handler="CreateOrEdit" onsubmit="return jQueryModalPost(this);" class="form-horizontal">

    <div class="col-12" id="accordion">
        @for (int i = 0; i < Model.Count; i++)
        {
            if (Model[i].ParentFeatureId == null)
            {
                if (i > 0)
                {
                    @Html.Raw(HttpUtility.HtmlDecode("</div></div></div>"))

                }
                var list = Model.Where(m => m.ParentFeatureId == Model[i].Id).ToList();
                var content = @"<div class='card card-primary card-outline'>
                    <a class='d-block w-100 collapsed' data-toggle='collapse' href='#collapseOne' aria-expanded='false'>
                        <div class='card-header'>
                            <h4 class='card-title w-100'>
                                " + @Model[i].ParentFeatureTitle + @"
                            </h4>
                        </div>
                    </a>
                    <div id='collapseOne' class='collapse' data-parent='#accordion' style=''>
                        <div class='card-body'>";
                @Html.Raw(HttpUtility.HtmlDecode(content));
            }
            else
            {
                <div class="form-group col-md-6">
                    @Html.CheckBoxFor(m => m[i].IsMain)
                    <label class="control-label">@Model[i].FeatureTitle</label>
                    @Html.TextBoxFor(m => m[i].Value)
                </div>                
            }

        }

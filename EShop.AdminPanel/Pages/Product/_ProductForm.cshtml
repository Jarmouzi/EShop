 @model EShop.ViewModel.ProductViewModel
<form id="create-form" method="post" asp-page="Index" asp-route-id="@Model.Id" asp-page-handler="CreateOrEdit" onsubmit="return jQueryModalPost(this);" class="form-horizontal">
    @* <input type="hidden" asp-for="CreateDate" /> *@
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-group col-md-6">
        @Html.LabelFor(model => model.CategoryId, htmlAttributes: new { @class = "control-label" })
        <div class="row-fluid">
            @Html.DropDownListFor(c => c.CategoryId, Model.Categories, null, new { @class = "selectpicker form-control", data_live_search = "true" })
        </div>
    </div>
    <div class="form-group col-md-6">
        <label asp-for="BrandId" class="control-label">برند محصول</label>
        <select id="BrandId" asp-items="Model.Brands" class="form-control">
            <option value="">انتخاب نمایید</option>
        </select>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label">نام محصول</label>
        <input type="text" autocomplete="off" asp-for="Title" name="Title" class="form-control">
        <span asp-validation-for="Title" class="text-danger"></span>

    </div>
    <div class="form-group col-md-3 mt-5">
        @Html.CheckBoxFor(m => m.AvailableForSale)
        <label class="control-label">موجود</label>
    </div>
    <div class="form-group col-md-3 mt-5">
        @Html.CheckBoxFor(m => m.Confirmed)
        <label class="control-label">تایید</label>
    </div>
    <div class="form-group col-md-12 pull-left">        
        <div class="pull-left">
            <a onclick="clearForm()" class="btn btn-default">خالی کردن فرم</a>
            <button id="saveBtn" type="submit" class="btn btn-success">ایجاد</button>
            <a onclick="Search(0);" class="btn btn-info">جستجو</a>
        </div>
    </div>

</form>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);

</script>
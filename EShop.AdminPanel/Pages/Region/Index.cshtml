@page
@model EShop.AdminPanel.Pages.Region.IndexModel
@{
    ViewData["Title"] = "مناطق";
}
<section class="content-header">
    <h1>
        @ViewData["Title"]
    </h1>
    <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> داشبورد</a></li>
        <li><a href="#"><i class="fa fa-archive"></i> اطلاعات پایه</a></li>
        <li class="active">
            @ViewData["Title"]
        </li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="regionForm" class="row"></div>
                </div>
                <div class="box-body">
                    @*                     <div class="row pull-left" style="padding:20px">
                    <a onclick="jQueryModalGet('?handler=CreateOrEdit','Create Customer')" class="btn bg-success">
                    ایجاد
                    </a>
                    <a id="reload" class="btn bg-warning">
                    بارگذاری مجدد
                    </a>
                    </div> *@
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                    @* <div class="clearfix"></div> *@
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#regionForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial');

        });
        $(function () {
            $('#reload').on('click', function () {
                $('#viewAll').load('?handler=ViewAllPartial');
            });
        });
        clearRegion = () => {
            $('#create-form').attr('action', '/Region?id=00000000-0000-0000-0000-000000000000&handler=CreateOrEdit');
            $('#Title').val('');
            $('#Country').val('');
            $('#saveBtn').html('ایجاد');
        }

        SearchRegion = () => {
            //e.preventDefault();
            debugger;
            // var data = {
            //     Title: function () {
            //         return ($("input#Title").val());
            //     },
            //     Country: function () {
            //         return ($("input#Country").val());
            //     },
            // };
            // var data = JSON.stringify({
            //     Title: $("input#Title").val(),
            //     Country: $("input#Country").val(),
            // });

            var title = $("input#Title").val();
            var country = $("input#Country").val();

            //jQuerySearch(`?handler=SearchAsync?title=${title}?country=${country}`);

            //jQueryGet('?handler=ViewAllPartial&title=Model.Title&country=Model.Country', 'viewAll')
            $('#viewAll').load(`?handler=ViewAllPartial&title=${title}&country=${country}`);
        }

    </script>
}

@model IEnumerable<EShop.ViewModel.RegionViewModel>

<table class="table table-bordered" id="regions">
    <thead>
        <tr>
            <th>عملیات</th>
            <th>عنوان</th>
            <th>تایید</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count() != 0)
        {
            @foreach (var r in Model)
            {
                <tr>
                    <td text-right">
                        <a onclick="jQueryModalGet('?handler=CreateOrEdit&id=@r.Id','Edit Region')" class="btn btn-info text-white"> <i class="fa fa-edit"></i> </a>
                        <form method="post" asp-page="Index" asp-route-id="@r.Id" asp-page-handler="Delete" onsubmit="return jQueryModalDelete(this)" class="d-inline">
                            <button type="submit" class="btn btn-danger text-white"> <i class="fa fa-remove"></i></button>
                        </form>
                        <a asp-page="./Filter" asp-route-id="@r.Id" data-toggle="tooltip" data-placement="top" title="تعریف فیلتر های جستجو"><i class="fa fa-search"></i>  </a>
                    </td>
                    <td>@r.Title</td>
                    <td>
                        @r.Country
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        $("#regionTable").DataTable();
    });
</script>
@model IEnumerable<EShop.ViewModel.RegionViewModel>

<table class="table table-bordered" id="regions">
    <thead>
        <tr>
            <th>عملیات</th>
            <th>عنوان</th>
            <th>تایید</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count() != 0)
        {
            @foreach (var r in Model)
            {
                <tr>
                    <td class="d-inline">
                        <form method="post" asp-page="Index" asp-route-id="@r.Id" asp-page-handler="Delete" onsubmit="return jQueryDelete(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="حذف" class="d-link"> <i class="fa fa-remove"></i></button>
                        </form> |
                        <a onclick="jQueryGet('?handler=FormPartial&id=@r.Id','regionForm', 'ویرایش')" data-toggle="tooltip" data-placement="top" title="ویرایش"> <i class="fa fa-edit"></i> </a>
                        
                    </td>
                    <td>@r.Title</td>
                    <td>
                        @r.Country
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

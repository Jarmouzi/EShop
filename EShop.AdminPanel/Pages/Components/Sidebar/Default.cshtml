@using EShop.ViewModel;
@model IEnumerable<PanelResourceViewModel>

<aside class="main-sidebar">
    <section class="sidebar">

        <ul class="sidebar-menu" data-widget="tree">

            <li><a href="/dashboard/index"><i class="fa fa-dashboard"></i> <span>داشبورد</span></a></li>

            @foreach (var parent in Model.Where(m => m.ParentId == null).ToList())
            {
                var children = Model.Where(m => m.ParentId == parent.Id).ToList();

                @if (children.Any())
                {
                    <li class="treeview">
                        <a href="@parent.PageAddress">
                            <i class="@parent.Icon"></i>
                            <span>@parent.Title</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            @foreach (var child in children)
                            {
                                <li>
                                    <a href="@child.PageAddress">
                                        <i class="@child.Icon"></i>
                                        @child.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                else
                {
                    <li>
                        <a href="@parent.PageAddress">
                            <i class="@parent.Icon"></i>
                            <span>@parent.Title</span>
                        </a>
                    </li>
                }

            }

            <li><a href="/Doc/مستندات.pdf"><i class="fa fa-book"></i> <span>مستندات</span></a></li>
            @*<li class="header">LABELS</li>
            <li><a href="#"><i class="fa fa-circle-o text-red"></i> <span>Important</span></a></li>
            <li><a href="#"><i class="fa fa-circle-o text-yellow"></i> <span>Warning</span></a></li>
            <li><a href="#"><i class="fa fa-circle-o text-aqua"></i> <span>Information</span></a></li>*@
        </ul>
    </section>
</aside>

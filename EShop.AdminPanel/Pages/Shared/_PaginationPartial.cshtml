@using EShop.ViewModel;
@model PaginationViewModel

<div class="col-md-12">
    <ul class="pagination pull-left d-inline">
        <li class="page-item">
            <div class="label-light"> تعداد رکورد در هر صفحه: </div>
        </li>
        <li class="page-item" style="padding-left: 10px;">
            <select asp-for="@Model.Take" asp-items="@Model.PaginationList" class="form-control" onchange="Search(0);" onselect="Search(0);"></select>
        </li>
        @if (Model.Skip == 0)
        {
            <li class="page-item disabled">
                <a class="page-link"><i class="fa fa-angle-right"></i></a>
            </li>
            <li class="page-item disabled">
                <a class="page-link"><i class="fa fa-angle-double-right"></i></a>
            </li>
        }
        else
        {
            <li class="page-item">
                <a onclick="Search(0);" class="page-link"><i class="fa fa-angle-double-right"></i></a>
            </li>
            <li class="page-item">
                <a onclick="Search(@(Model.Skip - 1));" class="page-link"><i class="fa fa-angle-right"></i></a>
            </li>
        }

        @if (Model.TotalCount / Model.Take == Model.Skip)
        {
            <li class="page-item disabled">
                <a class="page-link"><i class="fa fa-angle-left"></i></a>
            </li>
            <li class="page-item disabled">
                <a class="page-link"><i class="fa fa-angle-double-left"></i></a>
            </li>
        }
        else
        {
            <li class="page-item">
                <a onclick="Search(@(Model.Skip + 1));" class="page-link"><i class="fa fa-angle-left"></i></a>
            </li>
            <li class="page-item">
                <a onclick="Search(@(Model.TotalCount / Model.Take));" asp-route-CurrentPage="@Model.TotalCount" class="page-link"><i class="fa fa-angle-double-left"></i></a>
            </li>
        }
    </ul>
</div>
<script>
    $(document).ready(function () {
        $("#regionTable").DataTable();
    });
</script>
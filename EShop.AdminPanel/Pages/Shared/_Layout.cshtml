

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />

    <title>پنل مدیریت فروشگاه اتما | @ViewData["Title"] </title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/EShop.AdminPanel.styles.css" asp-append-version="true" />
    <link href="~/css/site.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/lib/Ionicons/css/ionicons.min.css">
    <link rel="stylesheet" href="~/css/skins/_all-skins.min.css">
    <link rel="stylesheet" href="~/css/AdminLTE.css">
    <link href="~/lib/datatables/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
</head>
<body class="hold-transition skin-blue sidebar-mini">
    <div class="wrapper">
        <header class="main-header">
            <a class="logo" asp-area="" asp-page="/Index">
                <img src="~/etma-logo-min.png" class="brand-image img-circle elevation-3" width="40px" height="40px" />
                <span><b>پنل مدیریت فروشگاه اتما</b></span>
            </a>

            <partial name="_LoginPartial"></partial>
        </header>


        @await  Component.InvokeAsync("Sidebar")

        <div class="content-wrapper">
            @RenderBody()
        </div>
        <div class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false" id="form-modal">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"></h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
        <footer class="main-footer">
            <strong>
                &copy; 2023 -پنل مدیریت فروشگاه اتما - <a asp-area="" asp-page="/Privacy">حقوق</a>
            </strong>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/fastclick/lib/fastclick.js"></script>
    <script src="~/js/adminlte.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/jquery-sparkline/dist/jquery.sparkline.min.js"></script>
    <script src="~/lib/jquery-slimscroll/jquery.slimscroll.min.js"></script>
    <script src="~/lib/chart.js/Chart.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using EShop.ViewModel;
@model PaginatedViewModel<SupplierViewModel>

<table class="table table-bordered" id="suppliers">
    <thead>
        <tr>
            <th>عملیات</th>
             
					<th>Address</th> 
					<th>Banner</th> 
					<th>Confirmed</th> 
					<th>FaxNumber</th> 
					<th>Logo</th> 
					<th>OwnerId</th> 
					<th>PhoneNumber</th> 
					<th>Title</th>  
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Any())
        {
            @foreach (var m in Model.Data)
            {
                <tr>
                    <td class="d-inline">
                        <form method="post" asp-page="Index" asp-route-id="@m.Id" asp-page-handler="Delete" onsubmit="return jQueryDelete(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="???" class="d-link"> <i class="fa fa-remove"></i></button>
                        </form> |
                        <a onclick="jQueryGet('?handler=FormPartial&id=@m.Id',' + LOWER(TABLE_NAME) + N'Form', '??????')" data-toggle="tooltip" data-placement="top" title="??????"> <i class="fa fa-edit"></i> </a>

                    </td> <td>@m.Title</td><td>@m.OwnerId</td><td>@m.Address</td><td>@m.PhoneNumber</td><td>@m.FaxNumber</td><td>@m.Logo</td><td>@m.Banner</td> <td>
                        @if (m.Confirmed == true)
                        {
                            <input type="checkbox" checked="checked" disabled="disabled" />
                        }
                        else
                        {
                            <input type="checkbox" disabled="disabled" />
                        }
                    </td>                  
                    
                </tr>
            }
        }
        else
        {
            <tr>
				<td colspan="9">
                ?????? ???? ???
				</td>
            </tr>

        }
    </tbody>
</table>
<partial name="_paginationpartial" model="@Model.Pagination" />
<script>
    $(document).ready(function () {
        $("#supplierTable").DataTable();
    });
</script>

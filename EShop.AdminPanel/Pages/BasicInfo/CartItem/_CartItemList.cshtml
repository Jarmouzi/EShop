@using EShop.ViewModel;
@model PaginatedViewModel<CartItemViewModel>

<table class="table table-bordered" id="cartitems">
    <thead>
        <tr>
            <th>عملیات</th>
             
					<th>Amount</th> 
					<th>CartId</th> 
					<th>DiscountAmount</th> 
					<th>ProductHandle</th> 
					<th>ProductUrl</th> 
					<th>ProductVarientId</th> 
					<th>Quantity</th>  
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Any())
        {
            @foreach (var m in Model.Data)
            {
                <tr>
                    <td class="d-inline">
                        <form method="post" asp-page="Index" asp-route-id="@m.Id" asp-page-handler="Delete" onsubmit="return jQueryDelete(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="???" class="d-link"> <i class="fa fa-remove"></i></button>
                        </form> |
                        <a onclick="jQueryGet('?handler=FormPartial&id=@m.Id',' + LOWER(TABLE_NAME) + N'Form', '??????')" data-toggle="tooltip" data-placement="top" title="??????"> <i class="fa fa-edit"></i> </a>

                    </td> <td>@m.CartId</td><td>@m.Amount</td><td>@m.DiscountAmount</td><td>@m.Quantity</td><td>@m.ProductVarientId</td><td>@m.ProductHandle</td><td>@m.ProductUrl</td>                 
                    
                </tr>
            }
        }
        else
        {
            <tr>
				<td colspan="8">
                ?????? ???? ???
				</td>
            </tr>

        }
    </tbody>
</table>
<partial name="_paginationpartial" model="@Model.Pagination" />
<script>
    $(document).ready(function () {
        $("#cartitemTable").DataTable();
    });
</script>

@model EShop.ViewModel.UserProfileViewModel
<form id="create-form" method="post" asp-page="Index" asp-route-id="@Model.Id" asp-page-handler="CreateOrEdit" onsubmit="return jQueryModalPost(this);" class="form-horizontal">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-group col-md-6">
        <label class="control-label">نام</label>
        <input type="text" autocomplete="off" asp-for="Name" name="Name" class="form-control">
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label">نام خانوادگی</label>
        <input type="text" autocomplete="off" asp-for="Family" name="Family" class="form-control">
        <span asp-validation-for="Family" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label">کد ملی</label>
        <input type="text" autocomplete="off" asp-for="NationalCode" name="NationalCode" class="form-control">
        <span asp-validation-for="NationalCode" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label">شماره موبایل</label>
        <input type="text" autocomplete="off" asp-for="PhoneNumber" name="PhoneNumber" class="form-control">
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label class="control-label">ایمیل</label>
        <input type="text" autocomplete="off" asp-for="Email" name="Email" class="form-control">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group col-md-12 pull-left">        
        <div class="pull-left">
            <a onclick="clearForm()" class="btn btn-default">خالی کردن فرم</a>
            <button id="saveBtn" type="submit" class="btn btn-success">ایجاد</button>
            <a onclick="Search(0);" class="btn btn-info">جستجو</a>
        </div>
    </div>

</form>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);

</script>

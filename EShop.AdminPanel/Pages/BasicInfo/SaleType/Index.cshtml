@page
@model EShop.AdminPanel.Pages.BasicInfo.SaleType.IndexModel
@{
    ViewData["Title"] = "SaleType";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="saletypeForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#saletypeForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/SaleType?id=&handler=CreateOrEdit');  
			$('#Confirmed).val(');  
			$('#InstallmentCount).val(');  
			$('#Profit).val(');  
			$('#Title).val('); 
            $('#saveBtn').html('?????');
        }

        Search = (take, skip) => {  
			var Confirmed = $("input#Confirmed").val(); 
			var InstallmentCount = $("input#InstallmentCount").val(); 
			var Profit = $("input#Profit").val(); 
			var Title = $("input#Title").val();
            $('#viewAll').load(`?handler=ViewAllPartial&&amp;Confirmed=${Confirmed}&amp;InstallmentCount=${InstallmentCount}&amp;Profit=${Profit}&amp;Title=${Title}&take=${take}&skip=${skip}`);
        }
    </script>
}

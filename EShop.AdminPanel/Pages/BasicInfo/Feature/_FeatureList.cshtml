@using EShop.ViewModel;
@model PaginatedViewModel<FeatureViewModel>

<table class="table table-bordered" id="features">
    <thead>
        <tr>
            <th>عملیات</th>
            <th>گروه محصول</th>
            <th>گروه مشخصات</th>
            <th>نام مشخصه</th>
            <th>تایید</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Data.Any())
        {
            @foreach (var m in Model.Data)
            {
                <tr>
                    <td class="d-inline">
                        <form method="post" asp-page="Index" asp-route-id="@m.Id" asp-page-handler="Delete" onsubmit="return jQueryDelete(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="حذف" class="d-link"> <i class="fa fa-remove"></i></button>
                        </form> 
                        <a onclick="jQueryGet('?handler=FormPartial&id=@m.Id','featureForm', 'ویرایش')" data-toggle="tooltip" data-placement="top" title="ویرایش"> <i class="fa fa-edit"></i> </a>
                        <form method="post" asp-page="Index" asp-route-id="@m.Id" asp-route-order="-1" asp-page-handler="ChangeOrder" onsubmit="return jQueryModalPost(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="بالا" class="d-link"> <i class="fa fa-chevron-up"></i></button>
                        </form>
                        <form method="post" asp-page="Index" asp-route-id="@m.Id" asp-route-order="1" asp-page-handler="ChangeOrder" onsubmit="return jQueryModalPost(this)">
                            <button type="submit" data-toggle="tooltip" data-placement="top" title="پایین" class="d-link"> <i class="fa fa-chevron-down"></i></button>
                        </form>
                    </td>
                    <td>@m.CategoryTitle</td>
                    <td>@m.ParentTitle</td>
                    <td>@m.Title</td>
                    <td>
                        @if (m.Confirmed == true)
                        {
                            <input type="checkbox" checked="checked" disabled="disabled" />
                        }
                        else
                        {
                            <input type="checkbox" disabled="disabled" />
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5">
                    رکوردی یافت نشد
                </td>
            </tr>

        }
    </tbody>
</table>
<partial name="_paginationpartial" model="@Model.Pagination" />
<script>
    $(document).ready(function () {
        $("#featureTable").DataTable();

        changeDisplayOrder = form => {
            try {
                $.ajax({
                    type: 'POST',
                    url: form.action,
                    data: new FormData(form),
                    contentType: false,
                    processData: false,
                    success: function (res) {
                        $('#viewAll').html(res);
                    },
                    error: function (err) {
                        console.log(err)
                    }
                })
            } catch (ex) {
                console.log(ex)
            }

            //prevent default form submit event
            return false;
        }
    });
</script>

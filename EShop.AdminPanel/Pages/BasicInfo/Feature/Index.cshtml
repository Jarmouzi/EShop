@page
@model EShop.AdminPanel.Pages.BasicInfo.Feature.IndexModel
@{
    ViewData["Title"] = "مشخصات گروه محصول";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="featureForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#featureForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/Feature?id=&handler=CreateOrEdit');
            $("select#CategoryId").val('');
            $("select#ParentId").val('');
            $('#Title').val('');
            $('#IsMain').val('');
            $('#Confirmed').val('');
			//$('#Icon').val('');  
            $('#saveBtn').html('ایجاد');
        }

        Search = (skip) => {
            var categoryId = $("select#CategoryId").val();
            var parentId = $("select#ParentId").val();
            var title = $("input#Title").val();
            var take = $("select#Take").val();
            $('#viewAll').load(`?handler=ViewAllPartial&categoryId=${categoryId}&parentId=${parentId}&title=${title}&take=${take}&skip=${skip}`);
        }
    </script>
}

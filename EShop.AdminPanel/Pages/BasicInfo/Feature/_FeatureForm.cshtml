@model EShop.ViewModel.FeatureViewModel
<form id="create-form" method="post" asp-page="Index" asp-route-id="@Model.Id" asp-page-handler="CreateOrEdit" onsubmit="return jQueryModalPost(this);" class="form-horizontal">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="form-group col-md-6">
        <label asp-for="CategoryId" class="control-label">گروه محصول</label>
        <select asp-for="CategoryId" class="form-control selectpicker">
            @foreach (var c in Model.Categories)
            {
                var style = @c.Level == 1 ? "background-color:#3c8dbc; color:#fff; font-weight:bold;" : (@c.Level == 2 ? "font-weight:bold;" : "");

                if(c.Level == 2)
                {                    
                <div class="dropdown-divider"></div>
                }
                <option value="@c.Id" style=@style>@c.Title</option>

            }
        </select>
    </div>
    <div class="form-group col-md-6">
        @Html.LabelFor(model => model.ParentId, htmlAttributes: new { @class = "control-label" })
        <div class="row-fluid">
            @Html.DropDownListFor(c => c.ParentId, Model.Parents, null, new { @class = "selectpicker form-control", data_live_search = "true" })
        </div>
    </div>
    <div class="form-group col-md-6">
        @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(m => m.Title, htmlAttributes: new { @class = "form-control", autocomplete = "off" })
        <span asp-validation-for="Title" class="text-danger"></span>

    </div>
    <div class="form-group col-md-3 mt-5">
        @Html.CheckBoxFor(m => m.IsMain)
        @Html.LabelFor(model => model.IsMain, htmlAttributes: new { @class = "control-label" })
    </div>
    <div class="form-group col-md-3 mt-5">
        @Html.CheckBoxFor(m => m.Confirmed)
        @Html.LabelFor(model => model.Confirmed, htmlAttributes: new { @class = "control-label" })
    </div>
    <div class="form-group col-md-12 pull-left">
        <div class="pull-left">
            <a onclick="clearForm()" class="btn btn-default">خالی کردن فرم</a>
            <button id="saveBtn" type="submit" class="btn btn-success">ایجاد</button>
            <a onclick="Search(0);" class="btn btn-info">جستجو</a>
        </div>
    </div>

</form>
<script type="text/javascript" language=javascript>
    $.validator.unobtrusive.parse(document);

</script>

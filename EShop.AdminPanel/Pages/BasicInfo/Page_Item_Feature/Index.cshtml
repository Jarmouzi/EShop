@page
@model EShop.AdminPanel.Pages.BasicInfo.Page_Item_Feature.IndexModel
@{
    ViewData["Title"] = "Page_Item_Feature";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="page_item_featureForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#page_item_featureForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/Page_Item_Feature?id=00000000-0000-0000-0000-000000000000&handler=CreateOrEdit');  
			$('#ComponentName).val(');  
			$('#Confirmed).val(');  
			$('#Page_Item_Id).val(');  
			$('#Title).val('); 
            $('#saveBtn').html('?????');
        }

        Search = (take, skip) => {  
			var ComponentName = $("input#ComponentName").val(); 
			var Confirmed = $("input#Confirmed").val(); 
			var Page_Item_Id = $("input#Page_Item_Id").val(); 
			var Title = $("input#Title").val();
            $('#viewAll').load(`?handler=ViewAllPartial&&amp;ComponentName=${ComponentName}&amp;Confirmed=${Confirmed}&amp;Page_Item_Id=${Page_Item_Id}&amp;Title=${Title}&take=${take}&skip=${skip}`);
        }
    </script>
}

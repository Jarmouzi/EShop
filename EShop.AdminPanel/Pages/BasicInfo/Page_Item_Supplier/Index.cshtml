@page
@model EShop.AdminPanel.Pages.BasicInfo.Page_Item_Supplier.IndexModel
@{
    ViewData["Title"] = "Page_Item_Supplier";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="page_item_supplierForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#page_item_supplierForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/Page_Item_Supplier?id=00000000-0000-0000-0000-000000000000&handler=CreateOrEdit');  
			$('#Confirmed).val(');  
			$('#Discount).val(');  
			$('#Price).val(');  
			$('#RemainedCount).val(');  
			$('#SupplierId).val(');  
			$('#Title).val('); 
            $('#saveBtn').html('?????');
        }

        Search = (take, skip) => {  
			var Confirmed = $("input#Confirmed").val(); 
			var Discount = $("input#Discount").val(); 
			var Price = $("input#Price").val(); 
			var RemainedCount = $("input#RemainedCount").val(); 
			var SupplierId = $("input#SupplierId").val(); 
			var Title = $("input#Title").val();
            $('#viewAll').load(`?handler=ViewAllPartial&&amp;Confirmed=${Confirmed}&amp;Discount=${Discount}&amp;Price=${Price}&amp;RemainedCount=${RemainedCount}&amp;SupplierId=${SupplierId}&amp;Title=${Title}&take=${take}&skip=${skip}`);
        }
    </script>
}

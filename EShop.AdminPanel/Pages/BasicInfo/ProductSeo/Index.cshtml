@page
@model EShop.AdminPanel.Pages.BasicInfo.ProductSeo.IndexModel
@{
    ViewData["Title"] = "ProductSeo";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="productseoForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#productseoForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $("#create-form").attr("action", "/ProductSeo?id=&handler=CreateOrEdit"); 
            $(".validation-summary-errors").val("");
            $("field-validation-error").val("");  
			$('#Description).val(');  
			$('#IsName).val(');  
			$('#ProductVariantId).val(');  
			$('#Title).val('); 
            $("#saveBtn").html("?????");
        }

        Search = (take, skip) => {  
			var Description = $("input#Description").val(); 
			var IsName = $("input#IsName").val(); 
			var ProductVariantId = $("input#ProductVariantId").val(); 
			var Title = $("input#Title").val();
            $("#viewAll").load(`?handler=ViewAllPartial&&amp;Description=${Description}&amp;IsName=${IsName}&amp;ProductVariantId=${ProductVariantId}&amp;Title=${Title}&take=${take}&skip=${skip}`);
        }
    </script>
}

@page
@model EShop.AdminPanel.Pages.BasicInfo.Stock.IndexModel
@{
    ViewData["Title"] = "Stock";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="stockForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#stockForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/Stock?id=00000000-0000-0000-0000-000000000000&handler=CreateOrEdit');  
			$('#Confirmed).val(');  
			$('#Count).val(');  
			$('#Date).val(');  
			$('#Desc).val(');  
			$('#InventoryId).val(');  
			$('#Item_FeatureId1).val(');  
			$('#Item_FeatureId2).val(');  
			$('#Item_FeatureId3).val(');  
			$('#ItemId).val(');  
			$('#Price).val(');  
			$('#Title).val(');  
			$('#TranType).val('); 
            $('#saveBtn').html('?????');
        }

        Search = (take, skip) => {  
			var Confirmed = $("input#Confirmed").val(); 
			var Count = $("input#Count").val(); 
			var Date = $("input#Date").val(); 
			var Desc = $("input#Desc").val(); 
			var InventoryId = $("input#InventoryId").val(); 
			var Item_FeatureId1 = $("input#Item_FeatureId1").val(); 
			var Item_FeatureId2 = $("input#Item_FeatureId2").val(); 
			var Item_FeatureId3 = $("input#Item_FeatureId3").val(); 
			var ItemId = $("input#ItemId").val(); 
			var Price = $("input#Price").val(); 
			var Title = $("input#Title").val(); 
			var TranType = $("input#TranType").val();
            $('#viewAll').load(`?handler=ViewAllPartial&&amp;Confirmed=${Confirmed}&amp;Count=${Count}&amp;Date=${Date}&amp;Desc=${Desc}&amp;InventoryId=${InventoryId}&amp;Item_FeatureId1=${Item_FeatureId1}&amp;Item_FeatureId2=${Item_FeatureId2}&amp;Item_FeatureId3=${Item_FeatureId3}&amp;ItemId=${ItemId}&amp;Price=${Price}&amp;Title=${Title}&amp;TranType=${TranType}&take=${take}&skip=${skip}`);
        }
    </script>
}

@page
@model EShop.AdminPanel.Pages.BasicInfo.Filter.IndexModel
@{
    ViewData["Title"] = "Filter";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="filterForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#filterForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&country=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/Filter?id=&handler=CreateOrEdit');  
			$('#CategoryId).val(');  
			$('#ComponentName).val(');  
			$('#Confirmed).val(');  
			$('#FeatureId).val(');  
			$('#Title).val('); 
            $('#saveBtn').html('?????');
        }

        Search = (take, skip) => {  
			var CategoryId = $("input#CategoryId").val(); 
			var ComponentName = $("input#ComponentName").val(); 
			var Confirmed = $("input#Confirmed").val(); 
			var FeatureId = $("input#FeatureId").val(); 
			var Title = $("input#Title").val();
            $('#viewAll').load(`?handler=ViewAllPartial&&amp;CategoryId=${CategoryId}&amp;ComponentName=${ComponentName}&amp;Confirmed=${Confirmed}&amp;FeatureId=${FeatureId}&amp;Title=${Title}&take=${take}&skip=${skip}`);
        }
    </script>
}

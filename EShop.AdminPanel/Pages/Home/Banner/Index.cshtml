@page
@model EShop.AdminPanel.Pages.Banner.IndexModel
@{
    ViewData["Title"] = "بنر";
}
@await Component.InvokeAsync("Breadcrumb")
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-info">
                <div class="box-header with-border">
                    <div id="bannerForm" class="row"></div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div id="viewAll" class="card-body table-responsive col-sm-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
    {
    <script>
        $(document).ready(function () {
            $('#bannerForm').load('?handler=FormPartial');
            $('#viewAll').load('?handler=ViewAllPartial&title=&take=10&skip=0');
        });

        clearForm = () => {
            $('#create-form').attr('action', '/Banner?id=&handler=CreateOrEdit');
            $('#Title').val('');
            $('#UploadedFile').val('');
            $('#Path').val('');
            $('#Confirmed').val('');
            $(".validation-summary-errors").val("");
            $("field-validation-error").val("");
            $('#saveBtn').html('ایجاد');
        }

        Search = (take, skip) => {
            var title = $("input#Title").val();
            var country = $("input#Country").val();
            $('#viewAll').load(`?handler=ViewAllPartial&title=${title}&take=${take}&skip=${skip}`);
        }
    </script>
}
